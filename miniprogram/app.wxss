/* ===== 全局样式 ===== */
page {
  background: #f1f5f9;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", Helvetica, sans-serif;
  color: #1e293b;
  font-size: 26rpx;
}
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.06);
}
.muted { color: #94a3b8; }
.up { color: #dc2626; }      /* 涨：红（A股习惯） */
.down { color: #16a34a; }    /* 跌：绿 */
.no-data { color: #cbd5e1; text-align: center; padding: 40rpx; }

/* ===== 底部来源弹层（替代 web 的 hover tooltip） ===== */
.mask {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(15, 23, 42, 0.35);
  z-index: 50;
}
.sheet {
  position: fixed; left: 0; right: 0; bottom: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 40rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  z-index: 51;
  transform: translateY(100%);
  transition: transform .25s ease;
}
.sheet.show { transform: translateY(0); }
.sheet .sheet-title { font-size: 30rpx; font-weight: 700; margin-bottom: 8rpx; }
.sheet .sheet-sub { font-size: 24rpx; color: #94a3b8; margin-bottom: 24rpx; }
.sheet .sheet-row { display: flex; align-items: center; justify-content: space-between; padding: 18rpx 0; border-top: 1rpx solid #f1f5f9; }
.sheet .sheet-row .k { color: #64748b; }
.sheet .sheet-row .v { font-weight: 600; font-size: 28rpx; }
.sheet .sheet-close { margin-top: 24rpx; text-align: center; color: #2563eb; font-weight: 600; }

/* ===== 表格（日价格 / 月均价 共用） ===== */
.page { padding-bottom: 40rpx; }
.bar { display: flex; align-items: center; justify-content: space-between; padding: 16rpx 24rpx; }
.picker { background: #fff; border-radius: 12rpx; padding: 12rpx 24rpx; font-weight: 600; box-shadow: 0 2rpx 12rpx rgba(15,23,42,.06); }
.hint { color: #94a3b8; font-size: 22rpx; }
.hscroll { width: 100%; white-space: nowrap; }
.tbl { display: inline-block; min-width: 100%; }
.tr { display: flex; align-items: stretch; }
.tr.head { background: #f8fafc; }
.tr.cat { background: #eef2f7; }
.tr.cat .catname { flex: 1; font-weight: 700; color: #334155; padding: 12rpx 16rpx; font-size: 24rpx; }
.td { flex: 0 0 auto; width: 120rpx; padding: 14rpx 10rpx; text-align: center; border-bottom: 1rpx solid #f1f5f9; font-size: 22rpx; box-sizing: border-box; }
.td.sticky { position: sticky; left: 0; z-index: 2; background: #fff; }
.td.w-name { width: 160rpx; text-align: left; padding-left: 16rpx; font-weight: 600; }
.td.w-unit { width: 90rpx; color: #94a3b8; left: 160rpx; }
.td.tap { border-bottom: 1rpx dotted #94a3b8; }
.tr.head .td { font-weight: 700; color: #475569; }
.td.today { background: #fff7ed; }
.td.latest { background: #eff6ff; font-weight: 700; }
.td.avg { width: 130rpx; background: #f8fafc; font-weight: 600; }
.td.empty { color: #cbd5e1; }
