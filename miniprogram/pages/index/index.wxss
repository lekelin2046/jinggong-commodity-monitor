.wrap { padding: 20rpx 0 40rpx; }
.head { padding: 8rpx 32rpx 20rpx; }
.head .title { display: block; font-size: 36rpx; font-weight: 800; color: #1e293b; }
.head .sub { display: block; font-size: 22rpx; color: #94a3b8; margin-top: 6rpx; }

.grid { display: flex; flex-wrap: wrap; }
.kpi { width: calc(50% - 40rpx); margin: 10rpx 20rpx; }
.kpi-label { font-size: 24rpx; color: #64748b; }
.kpi-value { font-size: 44rpx; font-weight: 800; color: #1e293b; margin: 8rpx 0; }
.kpi-unit { font-size: 22rpx; font-weight: 500; color: #94a3b8; margin-left: 6rpx; }
.kpi-sub { font-size: 22rpx; }
.tip { margin: 20rpx; color: #64748b; font-size: 22rpx; }
