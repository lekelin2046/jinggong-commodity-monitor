<view class="wrap">
  <view class="head">
    <text class="title">有色金属价格看板</text>
    <text class="sub">数据更新：{{updated}} · 共 {{totalDays}} 个交易日</text>
  </view>

  <view wx:if="{{loading}}" class="card no-data">加载中…</view>

  <view wx:else class="grid">
    <view wx:for="{{cards}}" wx:key="label" class="card kpi">
      <view class="kpi-label">{{item.label}}</view>
      <view class="kpi-value">{{item.value}}<text class="kpi-unit">{{item.unit}}</text></view>
      <view class="kpi-sub {{item.up === true ? 'up' : (item.up === false ? 'down' : 'muted')}}">{{item.sub}}</view>
    </view>
  </view>

  <view class="card tip">点击底部「日价格 / 月均价」查看明细；品种名可点击查看数据来源。</view>
</view>
